# ---------------------------------------------------------------------------
# Praxis environment configuration
#
# These are SERVER-SIDE ONLY secrets. They are read exclusively by the
# serverless functions in /api and by the scripts in /scripts. They are NEVER
# bundled into or exposed to client-side code (there is no VITE_/NEXT_PUBLIC_
# prefix, so nothing here is shipped to the browser).
#
# Copy this file to `.env` (which is git-ignored) and fill in real values for
# local development. In production, set the same variables in the Vercel
# project settings (Settings -> Environment Variables).
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (use the -pooler host for serverless).
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Secret used to sign/derive session tokens stored in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
